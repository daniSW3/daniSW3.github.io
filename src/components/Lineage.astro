---
/**
 * A small data-lineage graph: where the work starts and where it lands.
 * Two layouts are rendered from one definition: wide (desktop) and tall (mobile).
 */
type Node = { id: string; title: string; sub: string; col: number; kind?: 'end' };
const nodes: Node[] = [
  { id: 'erp', title: 'Sales & ERP', sub: 'transactions', col: 0 },
  { id: 'apps', title: 'Field apps', sub: 'orders, agents', col: 0 },
  { id: 'surveys', title: 'Surveys', sub: 'NPS, feedback', col: 0 },
  { id: 'transform', title: 'Transform', sub: 'SQL, dbt, Python', col: 1 },
  { id: 'model', title: 'Model', sub: 'facts & dimensions', col: 2 },
  { id: 'pbi', title: 'Power BI', sub: 'semantic models', col: 3 },
  { id: 'st', title: 'Streamlit', sub: 'web apps', col: 3 },
  { id: 'decide', title: 'Decisions', sub: 'finance, sales, ops', col: 4, kind: 'end' },
];
const edges: [string, string][] = [
  ['erp', 'transform'], ['apps', 'transform'], ['surveys', 'transform'],
  ['transform', 'model'],
  ['model', 'pbi'], ['model', 'st'],
  ['pbi', 'decide'], ['st', 'decide'],
];

type Box = { x: number; y: number; w: number; h: number };

/* Wide layout: columns left to right */
const W = { w: 120, h: 56, gap: 16 };
const wideY: Record<string, number> = { erp: 0, apps: 84, surveys: 168, transform: 84, model: 84, pbi: 42, st: 126, decide: 84 };
const wide: Record<string, Box> = Object.fromEntries(
  nodes.map((n) => [n.id, { x: n.col * (W.w + W.gap), y: wideY[n.id], w: W.w, h: W.h }]),
);
const wideW = 5 * W.w + 4 * W.gap;
const wideH = 168 + W.h;
const hPath = (a: Box, b: Box) => {
  const x1 = a.x + a.w, y1 = a.y + a.h / 2, x2 = b.x, y2 = b.y + b.h / 2, m = (x1 + x2) / 2;
  return `M${x1} ${y1} C${m} ${y1} ${m} ${y2} ${x2} ${y2}`;
};

/* Tall layout: rows top to bottom */
const T = { h: 50, rowGap: 30 };
const tallW = 320;
const row = (r: number) => r * (T.h + T.rowGap);
const tall: Record<string, Box> = {
  erp: { x: 0, y: row(0), w: 100, h: T.h },
  apps: { x: 110, y: row(0), w: 100, h: T.h },
  surveys: { x: 220, y: row(0), w: 100, h: T.h },
  transform: { x: 70, y: row(1), w: 180, h: T.h },
  model: { x: 70, y: row(2), w: 180, h: T.h },
  pbi: { x: 20, y: row(3), w: 135, h: T.h },
  st: { x: 165, y: row(3), w: 135, h: T.h },
  decide: { x: 70, y: row(4), w: 180, h: T.h },
};
const tallH = row(4) + T.h;
const vPath = (a: Box, b: Box) => {
  const x1 = a.x + a.w / 2, y1 = a.y + a.h, x2 = b.x + b.w / 2, y2 = b.y, m = (y1 + y2) / 2;
  return `M${x1} ${y1} C${x1} ${m} ${x2} ${m} ${x2} ${y2}`;
};

const colOf = Object.fromEntries(nodes.map((n) => [n.id, n.col]));
const pad = 6;
---

<figure class="lineage" aria-labelledby="lineage-caption" data-lineage>
  {[
    { key: 'wide', boxes: wide, vw: wideW, vh: wideH, path: hPath },
    { key: 'tall', boxes: tall, vw: tallW, vh: tallH, path: vPath },
  ].map((L) => (
    <svg
      class={`lineage__svg lineage__svg--${L.key}`}
      viewBox={`${-pad} ${-pad} ${L.vw + pad * 2} ${L.vh + pad * 2}`}
      aria-hidden="true"
    >
      <defs>
        <marker id={`arrow-${L.key}`} viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0 0.5 L7 4 L0 7.5" fill="none" stroke="currentColor" stroke-width="1.4" />
        </marker>
      </defs>
      <g class="lineage__edges">
        {edges.map(([a, b]) => (
          <path
            class="edge"
            d={L.path(L.boxes[a], L.boxes[b])}
            pathLength="1"
            marker-end={`url(#arrow-${L.key})`}
            style={`--d:${0.25 + colOf[a] * 0.32}s`}
          />
        ))}
      </g>
      <g class="lineage__nodes">
        {nodes.map((n) => {
          const b = L.boxes[n.id];
          return (
            <g class={`node${n.kind === 'end' ? ' node--end' : ''}`} style={`--d:${n.col * 0.32}s`}>
              <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="8" />
              {n.kind === 'end' && <circle class="node__signal" cx={b.x + b.w - 11} cy={b.y + 11} r="3.5" />}
              <text x={b.x + 11} y={b.y + 22} class="node__title">{n.title}</text>
              <text x={b.x + 11} y={b.y + 39} class="node__sub">{n.sub}</text>
            </g>
          );
        })}
      </g>
    </svg>
  ))}
  <figcaption id="lineage-caption" class="sr-only">
    How I work: data from sales and ERP systems, field apps and surveys is transformed with SQL, dbt and
    Python into a dimensional model, which feeds Power BI and Streamlit apps used for finance, sales and
    operations decisions.
  </figcaption>
</figure>

<style>
  .lineage { margin: 0; color: var(--line-strong); }
  .lineage__svg { width: 100%; max-width: 46rem; height: auto; margin-inline: auto; overflow: visible; }
  .lineage__svg--tall { display: none; max-width: 26rem; margin-inline: auto; }
  @media (max-width: 640px) {
    .lineage__svg--wide { display: none; }
    .lineage__svg--tall { display: block; }
  }

  .edge {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 0.7s cubic-bezier(0.55, 0, 0.3, 1) var(--d) forwards;
  }
  .node rect {
    fill: var(--paper);
    stroke: var(--line-strong);
    stroke-width: 1;
  }
  .node {
    opacity: 0;
    animation: appear 0.45s ease-out var(--d) forwards;
  }
  .node--end rect { stroke: var(--flow); stroke-width: 1.5; fill: var(--flow-soft); }
  .node__title { fill: var(--ink); font-size: 13.5px; font-weight: 640; }
  .node__sub { fill: var(--muted); font-size: 11px; font-weight: 450; }
  .node__signal { fill: var(--signal); }

  /* Flow colour arrives once everything has drawn (svg-level so arrowheads follow) */
  .lineage__svg { animation: settle 0.6s ease 1.9s forwards; }

  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes appear { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
  @keyframes settle { to { color: var(--flow); } }

  /* With JS, hold the drawing until the figure is on screen */
  .lineage[data-wait] .edge,
  .lineage[data-wait] .node,
  .lineage[data-wait] .lineage__svg { animation-play-state: paused; }

  @media (prefers-reduced-motion: reduce) {
    .edge { animation: none; stroke-dashoffset: 0; }
    .node { animation: none; opacity: 1; }
    .lineage__svg { animation: none; color: var(--flow); }
  }
</style>

<script>
  const fig = document.querySelector<HTMLElement>('[data-lineage]');
  if (fig && 'IntersectionObserver' in window) {
    const rect = fig.getBoundingClientRect();
    const inView = rect.top < window.innerHeight * 0.85 && rect.bottom > 0;
    if (!inView) {
      fig.setAttribute('data-wait', '');
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            fig.removeAttribute('data-wait');
            io.disconnect();
          }
        },
        { threshold: 0.35 },
      );
      io.observe(fig);
    }
  }
</script>
