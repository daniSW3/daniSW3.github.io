---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | Daniel Temesgen">
  <main id="main" class="wrap nf">
    <h1>This page doesn't exist</h1>
    <p>The link may be old or mistyped. Everything lives on the home page.</p>
    <a class="btn btn--primary" href="/">Go to the home page</a>
  </main>
</Base>

<style>
  .nf { min-height: 80vh; display: grid; place-content: center; gap: 1.25rem; text-align: center; justify-items: center; }
  .nf h1 { font-size: var(--s4); }
  .nf p { color: var(--muted); }
</style>
